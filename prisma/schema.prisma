generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  country      String?
  role         String        @default("investor")
  createdAt    DateTime      @default(now())
  investments  Investment[]
  reservations Reservation[]
}

model Deal {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  sector          String
  equipmentType   String
  brand           String
  model           String
  year            Int
  origin          String        @default("Chine")
  totalPrice      Float
  minInvestment   Float
  depositAmount   Float
  contractClient  String
  contractType    String
  contractDuration Int
  monthlyRevenue  Float
  paybackMonths   Int           @default(36)
  profitMonths    Int           @default(24)
  status          String        @default("open")
  imageUrl        String?
  description     String?
  raisedAmount    Float         @default(0)
  createdAt       DateTime      @default(now())
  investments     Investment[]
  reservations    Reservation[]
}

model Investment {
  id         String   @id @default(cuid())
  userId     String
  dealId     String
  amount     Float
  percentage Float
  status     String   @default("active")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  deal       Deal     @relation(fields: [dealId], references: [id])
}

model Reservation {
  id          String   @id @default(cuid())
  userId      String
  dealId      String
  depositPaid Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  deal        Deal     @relation(fields: [dealId], references: [id])
}
